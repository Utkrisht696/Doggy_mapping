+// Diagnostic only: one buffered CSV row per scan; no filter state writes.
+struct DoggyHeadingTrace {
+    const state_output &state;
+    double scan_time, first_yaw, previous_yaw;
+    double changes[3] = {0.,0.,0.};
+    int counts[3] = {0,0,0};
+    int negative_dt = 0, lidar_success = 0, imu_residual_count = 0;
+    double min_dt = 1e9, max_dt = -1e9, gyro_residual_sq = 0., acc_residual_sq = 0.;
+    static double yaw(const state_output &s) {
+        const auto R = s.rot.normalized().toRotationMatrix();
+        return std::atan2(R(1,0), R(0,0));
+    }
+    static double wrap(double angle) { return std::atan2(std::sin(angle), std::cos(angle)); }
+    static std::ofstream &file() {
+        static std::ofstream out(DEBUG_FILE_DIR("heading_trace.csv"));
+        static bool header = false;
+        if (!header) {
+            out.precision(17);
+            out << "scan_stamp_s,dyaw_prediction_rad,dyaw_imu_rad,dyaw_lidar_rad,dyaw_total_rad,prediction_count,imu_count,lidar_count,lidar_success,negative_prediction_dt,min_prediction_dt_s,max_prediction_dt_s,gyro_innovation_rms_vector,acc_innovation_rms_vector,roll_rad,pitch_rad,yaw_rad,px,py,pz,omgx,omgy,omgz,bgx,bgy,bgz,bax,bay,baz,qx,qy,qz,qw\n";
+            header = true;
+        }
+        return out;
+    }
+    DoggyHeadingTrace(const state_output &s, double time):state(s),scan_time(time),first_yaw(yaw(s)),previous_yaw(first_yaw) { file(); }
+    void imu_before(const V3D &gyro, const V3D &acc) {
+        gyro_residual_sq += (gyro-state.omg-state.bg).squaredNorm();
+        acc_residual_sq += (acc*G_m_s2/acc_norm-state.acc-state.ba).squaredNorm();
+        ++imu_residual_count;
+    }
+    void sample(int phase, double dt = 0.) {
+        double current = yaw(state);
+        changes[phase] += wrap(current-previous_yaw);
+        previous_yaw = current;
+        ++counts[phase];
+        if (phase == 0) {
+            if (dt < 0.) ++negative_dt;
+            if (dt < min_dt) min_dt = dt;
+            if (dt > max_dt) max_dt = dt;
+        }
+    }
+    ~DoggyHeadingTrace() {
+        auto &out = file();
+        const auto R = state.rot.normalized().toRotationMatrix();
+        double roll = std::atan2(R(2,1),R(2,2));
+        double pitch = std::atan2(-R(2,0),std::hypot(R(2,1),R(2,2)));
+        out << scan_time << ',' << changes[0] << ',' << changes[1] << ',' << changes[2] << ',' << wrap(yaw(state)-first_yaw)
+            << ',' << counts[0] << ',' << counts[1] << ',' << counts[2] << ',' << lidar_success << ',' << negative_dt
+            << ',' << (counts[0]?min_dt:0.) << ',' << (counts[0]?max_dt:0.)
+            << ',' << (imu_residual_count?std::sqrt(gyro_residual_sq/imu_residual_count):0.)
+            << ',' << (imu_residual_count?std::sqrt(acc_residual_sq/imu_residual_count):0.)
+            << ',' << roll << ',' << pitch << ',' << yaw(state);
+        for (int i=0;i<3;++i) out << ',' << state.pos[i];
+        for (int i=0;i<3;++i) out << ',' << state.omg[i];
+        for (int i=0;i<3;++i) out << ',' << state.bg[i];
+        for (int i=0;i<3;++i) out << ',' << state.ba[i];
+        for (int i=0;i<4;++i) out << ',' << state.rot.coeffs()[i];
+        out << '\n';
+    }
+};
 
 const float MOV_THRESHOLD = 1.5f;
 
