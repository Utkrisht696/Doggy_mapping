Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 45; 45; 48
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Live 2D walls - higher returns
    Enabled: true
    Alpha: 1.0
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /walls/map
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Use Timestamp: false
  - Class: rviz_default_plugins/Axes
    Name: Robot position
    Enabled: true
    Reference Frame: base_footprint
    Length: 0.35
    Radius: 0.035
  - Class: rviz_default_plugins/Map
    Name: Terrain assessment (optional)
    Enabled: false
    Alpha: 1.0
    Color Scheme: map
    Topic:
      Value: /terrain/traversability
      Depth: 1
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down walls
      Target Frame: odom
      Scale: 45
      X: 2
      Y: 0
      Angle: 0
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Width: 1200
  Height: 850
