<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="enp7s0" priority="default" multicast="default" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Internal>
      <!-- Same receive-buffer setting validated in the passive timing tests. -->
      <SocketReceiveBufferSize min="8 MiB" max="8 MiB" />
    </Internal>
  </Domain>
</CycloneDDS>
