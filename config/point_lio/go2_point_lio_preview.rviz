# Preview: existing sensors only. No estimator or map TF is required.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Latest registered scan1
    - /Map view - registered scans accumulated for 60 s1
    Splitter Ratio: 0.5
  Help Height: 90
  Tree Height: 600
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
  Experimental: false
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground grid
    Enabled: true
    Value: true
    Alpha: 0.4
    Cell Size: 1
    Color: 120; 130; 145
    Line Style:
      Line Width: 0.02
      Value: Lines
    Plane: XY
    Plane Cell Count: 20
    Normal Cell Count: 0
    Reference Frame: <Fixed Frame>
    Offset:
      X: 0
      Y: 0
      Z: 0
  - Class: rviz_default_plugins/RobotModel
    Name: Unitree Go2 - official URDF
    Enabled: true
    Value: true
    Alpha: 1.0
    Visual Enabled: true
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    TF Prefix: ''
    Update Interval: 0
    Links:
      All Links Enabled: true
      Expand Tree: false
      Link Tree Style: Links in Alphabetic Order
  - Class: rviz_default_plugins/PointCloud2
    Name: Latest registered scan
    Enabled: false
    Value: false
    Alpha: 1.0
    Color: 255; 210; 100
    Color Transformer: FlatColor
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 3
    Size (m): 0.01
    Decay Time: 0.15
    Selectable: true
    Use Fixed Frame: true
    Topic:
      Value: /point_lio/cloud_registered
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/PointCloud2
    Name: Map view - registered scans accumulated for 60 s
    Enabled: false
    Value: false
    Alpha: 1.0
    Color: 255; 210; 100
    Color Transformer: AxisColor
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 2
    Size (m): 0.01
    Decay Time: 60.0
    Selectable: true
    Use Fixed Frame: true
    Topic:
      Value: /point_lio/cloud_registered
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Axis: Z
    Autocompute Value Bounds:
      Value: true
    Use rainbow: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 90; 255; 130
    Enabled: false
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Lines
    Line Width: 0.029999999329447746
    Name: Point-LIO trajectory
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /point_lio/path
    Value: false
  - Class: rviz_default_plugins/PointCloud2
    Name: Raw LiDAR - enable for preview
    Enabled: true
    Value: true
    Alpha: 0.8
    Color: 255; 184; 70
    Color Transformer: FlatColor
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 3
    Size (m): 0.01
    Decay Time: 0.15
    Selectable: true
    Use Fixed Frame: true
    Topic:
      Value: /utlidar/cloud
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/TF
    Name: Canonical TF - optional
    Enabled: false
    Value: false
    Frame Timeout: 5
    Marker Scale: 0.2
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Update Interval: 0
    Frames:
      All Enabled: true
  Enabled: true
  Global Options:
    Background Color: 24; 29; 38
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.7
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: null
Window Geometry:
  Width: 1280
  Height: 900
  X: 60
  Y: 60
  Hide Left Dock: false
  Hide Right Dock: false
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Time:
    collapsed: false
